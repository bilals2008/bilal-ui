{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "pro-coming-soon",
  "title": "Pro Coming Soon",
  "description": "Pro version announcement section.",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [
